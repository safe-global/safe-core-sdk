# Settings for the policy scripts in playground/protocol-kit:
#   policies/*.ts
#
# Copy this file to `.env` in this directory (git-ignored) and fill it in. Node loads it natively:
#   node --env-file-if-exists=playground/protocol-kit/.env playground/protocol-kit/policies/guarded-safe.ts status
# Variables already set in the environment take precedence, so CI or a secret manager can provide
# them instead of the file. Never commit a real key.
#
# Every value below is a placeholder: replace it, or leave the variable empty when it is optional.
# A placeholder left in place fails validation rather than being used. Contract deployments
# (guards, policies, Safe v1.5.0, Allowance Modules) are protocol constants and stay in the code.

# ─── Secrets ────────────────────────────────────────────────────────────────────────────────────

# Signer key: owner of the test Safes, executor of every Safe transaction, SIWE sign-in. Required.
PRIVATE_KEY=

# Proposer delegate key (cgw-pending-policies.ts only): queues unsigned "in signing" transactions on
# threshold-1 Safes. Optional; any key that owns nothing, e.g. from `cast wallet new`.
PROPOSER_PRIVATE_KEY=

# ─── Network ────────────────────────────────────────────────────────────────────────────────────

# JSON-RPC endpoint for reads and transactions; the chain is taken from it. Dry runs of
# guarded-safe-setup.ts need eth_simulateV1.
RPC_URL=https://rpc.example.invalid

# Endpoint for historical event logs (teardown and status scans). Most public RPCs prune old logs;
# use one that serves archive logs. Defaults to RPC_URL.
LOGS_RPC_URL=https://archive-rpc.example.invalid

# ─── Safe Client Gateway ────────────────────────────────────────────────────────────────────────

# Default gateway (e.g. a local CGW) and the staging one (--staging / --gateway staging).
CGW_URL=http://localhost:5555
CGW_STAGING_URL=https://cgw-staging.example.invalid

# ─── Test accounts and token ────────────────────────────────────────────────────────────────────

# Second owner of the test Safes; default recipient of the test transfers and of swept funds.
CO_OWNER=<co-owner-address>

# Trusted address: the single-use ("once") entry of the default allowlists.
TRUSTED_ADDRESS=<trusted-address>

# ERC-20 the token policies, spending limits and test transfers use.
TEST_TOKEN=<erc20-token-address>

# guarded-safe-setup.ts: extra addresses allowlisted for native/ERC-20 transfers and approvals,
# comma-separated (the Safe owners and the demo recipient are always added).
ALLOWLIST=<address>,<address>

# ─── Known test Safes ───────────────────────────────────────────────────────────────────────────
# Lists are comma-separated `address` or `address:label` entries.

# The Safe with one of every guard policy kind (showcase-safe.ts, salt nonce 1001); the
# default of cgw-policy-requests.ts.
POLICY_SHOWCASE_SAFE=<safe-address>

# Safes cgw-space-policies.ts adds to a Space.
KNOWN_POLICY_SAFES="<safe-address>:<label>,<safe-address>:<label>"

# Safes with guard policies that cgw-pending-policies.ts acts on (owners/threshold · guards · bindings).
POLICY_TEST_SAFES="<safe-address>:<label>,<safe-address>:<label>"
